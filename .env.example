# =============================================================================
# Movie Bot Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Bot Configuration
# -----------------------------------------------------------------------------
BOT_TOKEN=your_bot_token_here
PRIVATE_CHANNEL_ID=-100xxxxxxxxxx
SUPER_ADMIN_ID=123456789

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# For Docker: use service names (postgres)
# For local: use localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=moviebot
DB_USER=moviebot
DB_PASSWORD=your_secure_password_here

# Full database URL (auto-generated from above or set manually)
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# For Docker: use service names (redis)
# For local: use localhost
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Full Redis URL (auto-generated from above or set manually)
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=production

# Debug mode (set to false in production)
DEBUG=false

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=/app/logs/bot.log

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Subscription channel check
SUBSCRIPTION_REQUIRED=false
SUBSCRIPTION_CHANNEL=@your_channel

# Maintenance mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Bot texnik ishlar uchun vaqtincha to'xtatilgan

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_SECONDS=60

# -----------------------------------------------------------------------------
# Backup Configuration (Optional)
# -----------------------------------------------------------------------------
BACKUP_CHANNEL_ID=
BACKUP_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# Cache Settings
# -----------------------------------------------------------------------------
CACHE_TTL_DEFAULT=3600
CACHE_TTL_MOVIES=1800
CACHE_TTL_RECOMMENDATIONS=1800

# -----------------------------------------------------------------------------
# Analytics (Optional)
# -----------------------------------------------------------------------------
# Enable analytics tracking
ANALYTICS_ENABLED=true
